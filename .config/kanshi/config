profile docked {
    output eDP-1 disable

    output DP-3 {
        mode 1920x1080@75.00Hz
        position -1920,0
        scale 1
    }

    output DP-6 {
        mode 1920x1080@75.00Hz
        position 0,0
        scale 1
    }

    output DP-4 {
        mode 1920x1080@75.00Hz
        position 1920,0
        scale 1
    }
}

profile undocked {
    output eDP-1 {
        mode preferred
        scale 1.8
    }
}
